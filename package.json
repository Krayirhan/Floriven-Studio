{
  "name": "floriven-studio",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "prompts:build": "node scripts/build-prompts.mjs",
    "benchmarks:validate": "node scripts/validate-benchmark-catalog.mjs",
    "benchmarks:run": "node scripts/run-benchmarks.mjs",
    "certification:preflight": "node scripts/certification/run-certification-preflight.mjs",
    "certification:security": "node scripts/certification/run-security-audit.mjs",
    "certification:runtime-replay": "node scripts/certification/compare-runtime-replay.mjs",
    "certification:runtime-baseline-approval": "node scripts/certification/validate-runtime-baseline-approval.mjs",
    "certification:runtime-release-evidence": "node scripts/certification/report-runtime-release-evidence.mjs",
    "certification:runtime-live-preflight": "node scripts/certification/runtime-live-preflight.mjs",
    "certification:final": "node scripts/certification/run-final-certification.mjs",
    "contracts:runtime-hierarchy": "node scripts/certification/build-runtime-hierarchy-profiles.mjs",
    "contracts:runtime-hierarchy:write": "node scripts/certification/build-runtime-hierarchy-profiles.mjs --write",
    "smoke:live": "node scripts/run-live-smoke.mjs",
    "test:generation-architecture": "pnpm --filter @floriven/web exec vitest --root ../.. run supabase/functions/generate/domain.test.ts supabase/functions/generate/quality.test.ts",
    "test:v3": "pnpm --filter @floriven/web exec vitest --root ../.. run supabase/functions/generation-v3",
    "test:e2e": "pnpm --filter @floriven/web test:e2e",
    "functions:deploy": "pnpm prompts:build && supabase functions deploy generate --project-ref ndhuwqzznivzscjqtxbj",
    "functions:deploy:v3": "supabase functions deploy generation-v3 --project-ref ndhuwqzznivzscjqtxbj"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "prettier": "^3.3.0",
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
